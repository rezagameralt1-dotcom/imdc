APP_NAME=IMDC
APP_ENV=local
APP_KEY=base64:I2BDWdeiMSQoGR4x0/gg65y66QMOphZihSYCF5bUJnI=
APP_DEBUG=true
APP_URL=http://127.0.0.1

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------- Database (Postgres) ----------
DATABASE_URL=
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=/var/www/imdc/database/database.sqlite
DB_USERNAME=reza
DB_PASSWORD=1

# ---------- Caching / Queue / Session ----------
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# اگر بعداً https داشتی، این رو true کن
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

# ---------- Redis ----------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Mail ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Auth / Sanctum ----------
# برای SPA/کلاینت‌هایی که کوکی CSRF می‌گیرند؛ برای Token API هم بی‌ضرره
SANCTUM_STATEFUL_DOMAINS=127.0.0.1,localhost

# ---------- Misc ----------
FILESYSTEM_DISK=local
MEMCACHED_HOST=127.0.0.1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

# === SPA / Sanctum dev ===
APP_URL=http://127.0.0.1
SPA_URL=http://localhost:5173
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
MARKETPLACE=on
HEALTH_USER=market@test.local
HEALTH_PASS=market1234
FEATURE_NFT=true
